<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- This framework theme exists from API 21 onward. Compose renders Material
         3 itself, so the XML parent only supplies the Activity window theme. -->
    <style name="Theme.NextGenEditor" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
